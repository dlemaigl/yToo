# Production Environment Variables for yToo
# IMPORTANT: Change all default values before deploying to production

# Database Configuration
DATABASE_URL=postgresql://ytoo_user:CHANGE_THIS_PASSWORD@postgres:5432/ytoo_prod
POSTGRES_DB=ytoo_prod
POSTGRES_USER=ytoo_user
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD

# Redis Configuration
REDIS_URL=redis://redis:6379

# JWT Configuration - MUST be changed for production
JWT_SECRET=CHANGE_THIS_TO_A_VERY_SECURE_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=24h

# Server Configuration
NODE_ENV=production
PORT=3001
LOG_LEVEL=info

# Frontend Configuration - Update with your actual domain
REACT_APP_API_URL=https://your-domain.com/api
REACT_APP_WS_URL=wss://your-domain.com

# SSL Configuration (if using HTTPS)
# SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
# SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Monitoring and Logging
# SENTRY_DSN=your_sentry_dsn_here
# LOG_LEVEL=info