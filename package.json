{
  "name": "ytoo-app",
  "version": "1.0.0",
  "description": "yToo group activity voting application",
  "scripts": {
    "dev": "docker-compose up --build",
    "dev:detached": "docker-compose up -d --build",
    "stop": "docker-compose down",
    "clean": "docker-compose down -v --remove-orphans",
    "logs": "docker-compose logs -f",
    "logs:backend": "docker-compose logs -f backend",
    "logs:frontend": "docker-compose logs -f frontend",
    "db:reset": "docker-compose down postgres && docker volume rm ytoo-app_postgres_data && docker-compose up -d postgres",
    "install:backend": "cd backend && npm install",
    "install:frontend": "cd frontend && npm install",
    "install:all": "npm run install:backend && npm run install:frontend",
    "test:backend": "cd backend && npm test",
    "test:frontend": "cd frontend && npm test",
    "deploy:prod": "bash scripts/deploy.sh deploy",
    "deploy:prod:win": "powershell -ExecutionPolicy Bypass -File scripts/deploy.ps1 deploy",
    "prod:start": "docker-compose -f docker-compose.prod.yml --env-file .env.production.local up -d",
    "prod:stop": "docker-compose -f docker-compose.prod.yml down",
    "prod:logs": "docker-compose -f docker-compose.prod.yml logs -f",
    "prod:status": "docker-compose -f docker-compose.prod.yml ps",
    "prod:backup": "node scripts/migrate-production.js backup",
    "prod:migrate": "node scripts/migrate-production.js migrate",
    "prod:health": "curl -f http://localhost/health || echo 'Health check failed'"
  },
  "keywords": ["voting", "groups", "activities", "react", "node"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}